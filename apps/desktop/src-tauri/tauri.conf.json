{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mino Workbench",
  "version": "0.1.5",
  "identifier": "dev.minoworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @mino/ui",
    "beforeBuildCommand": "npm run build --workspace @mino/ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mino Workbench",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
